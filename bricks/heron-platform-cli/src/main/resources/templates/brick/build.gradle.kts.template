plugins {
    `java-library`
    `maven-publish`
}

repositories {
    mavenLocal()
    mavenCentral()
}

java {
    toolchain {
        languageVersion = JavaLanguageVersion.of({{javaToolchainVersion}})
    }
}

dependencies {
    implementation("dev.hogwai.platform:heron-platform-spi:{{platformVersion}}")
    annotationProcessor("dev.hogwai.platform:heron-platform-processor:{{platformVersion}}")
}

publishing {
    publications {
        create<MavenPublication>("maven") {
            from(components["java"])
        }
    }
}
