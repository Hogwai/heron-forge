package {{basePackage}};

import dev.hogwai.platform.spi.host.HostAdapter;
import dev.hogwai.platform.spi.host.HostApplication;
import dev.hogwai.platform.spi.host.HostConfiguration;
import dev.hogwai.platform.spi.host.HostException;
import dev.hogwai.platform.spi.annotation.HeronService;

/** Starter host brick generated by Heron. */
@HeronService(value = HostAdapter.class, id = "host.{{projectName}}")
public final class {{className}}HostAdapter implements HostAdapter {

    private boolean ready;

    /** Creates a stopped host adapter. */
    public {{className}}HostAdapter() {
        // Default constructor
    }

    @Override
    public void start(HostApplication application, HostConfiguration configuration) throws HostException {
        throw new HostException("Host adapter implementation is not configured");
    }

    @Override
    public boolean ready() {
        return ready;
    }

    @Override
    public void stop() throws HostException {
        ready = false;
    }

    @Override
    public void close() {
        ready = false;
    }
}
